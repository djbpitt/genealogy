<?xml version="1.0" encoding="UTF-8"?>
<project default="xar" name="genealogy">
  <description>Genealogy of Kievan Rus′</description>
  <xmlproperty file="expath-pkg.xml" />
  <property name="project.version" value="${package(version)}" />
  <property name="project.app" value="${package(abbrev)}" />
  <property name="build.dir" value="build" />
  <target name="xar" description="compile release build">
    <mkdir dir="${build.dir}" />
    <zip basedir="." destfile="${build.dir}/${project.app}-${project.version}.xar" excludes="**/${build.dir}/**, .existdb.json, tests/**, **/private/** **/.git*/**" />
  </target>
</project>
